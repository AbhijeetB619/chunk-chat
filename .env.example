# Copy this file to .env and fill in your values
# Never commit .env to version control

# GitHub Models API endpoint
BASE_URL=https://models.github.ai/inference

# Embedding model (used for document ingestion and query embedding)
MODEL_NAME=text-embedding-3-large

# Chat model (used for generating answers)
CHAT_MODEL=gpt-4o-mini

# GitHub Models API token — generate at https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# Path to the directory containing .txt documents to ingest
DIR_PATH=./data/new_articles

# Local path for ChromaDB persistent storage
DB_PATH=./db/open_ai_embeddings_db

# ChromaDB collection name
COLLECTION_NAME=articles
